# SymfPress - Configuration Environment Variables Template
# Copiez ce fichier vers .env et adaptez les valeurs à votre environnement

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=CHANGE_THIS_SECRET_IN_PRODUCTION_MIN_32_CHARACTERS
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format: DATABASE_URL="scheme://username:password@host:port/database_name"
# Configurez selon votre base de données :

# Pour MySQL/MariaDB (recommandé pour SymfPress)
DATABASE_URL="mysql://username:password@host:port/database_name?serverVersion=8.0.32&charset=utf8mb4"

# Pour PostgreSQL
# DATABASE_URL="postgresql://username:password@host:port/database_name?serverVersion=16&charset=utf8"

# Pour SQLite (développement uniquement)
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Configuration pour l'envoi d'emails
MAILER_DSN=null://null
###< symfony/mailer ###

###> SymfPress Custom Settings ###
# Configuration spécifique à SymfPress

# Paramètres de sécurité
SECURE_TOKEN_SALT=CHANGE_THIS_SALT_IN_PRODUCTION

# Configuration des médias
MEDIA_MAX_FILE_SIZE=10M
MEDIA_ALLOWED_TYPES="jpg,jpeg,png,gif,pdf,doc,docx"
MEDIA_UPLOAD_PATH="/public/uploads"

# Configuration des thèmes
DEFAULT_THEME=default
THEME_CACHE_ENABLED=false

# Configuration multilingue
DEFAULT_LOCALE=fr
SUPPORTED_LOCALES="fr,en,es"

# Configuration des plugins
PLUGINS_ENABLED=true
PLUGINS_AUTO_DISCOVERY=true

# Configuration de cache
CACHE_ADAPTER=filesystem
REDIS_URL=redis://localhost:6379

# Configuration Rate Limiting
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT="5 per minute"
API_RATE_LIMIT="100 per hour"

# Configuration de log
LOG_LEVEL=debug
LOG_FILE_PATH="/var/log/symfpress.log"
###< SymfPress Custom Settings ###

###> External APIs (optionnel) ###
# Configuration pour APIs externes si nécessaire
# GOOGLE_API_KEY=your_google_api_key
# FACEBOOK_APP_ID=your_facebook_app_id
# TWITTER_API_KEY=your_twitter_api_key
###< External APIs ###

###> Development Tools ###
# Configuration pour les outils de développement
WEBPACK_ENCORE_ENABLED=true
WEBPACK_DEV_SERVER_URL=http://localhost:8080

# Configuration Xdebug (si utilisé)
# XDEBUG_MODE=debug
# XDEBUG_CLIENT_HOST=host.docker.internal
###< Development Tools ###
