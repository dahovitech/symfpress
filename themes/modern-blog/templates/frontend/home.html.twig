{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block hero_title %}Découvrez Modern Blog{% endblock %}
{% block hero_subtitle %}Le thème qui transforme votre expérience de lecture{% endblock %}

{% block content %}
    <!-- Articles en vedette -->
    {% if featured_posts is defined and featured_posts|length > 0 %}
        <section class="featured-posts mb-5">
            <h2 class="h3 mb-4">
                <i class="fas fa-star text-warning me-2"></i>
                Articles en Vedette
            </h2>
            
            <div class="row">
                {% for post in featured_posts|slice(0, 3) %}
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            {% if post.featuredImage %}
                                <img src="{{ post.featuredImage }}" class="card-img-top" alt="{{ post.title }}" style="height: 200px; object-fit: cover;">
                            {% endif %}
                            
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="{{ path('frontend_post', {slug: post.slug}) }}" class="post-title">
                                        {{ post.title|apply_filter('post_title') }}
                                    </a>
                                </h5>
                                
                                <p class="card-text">{{ post.excerpt|slice(0, 150) }}...</p>
                                
                                <div class="post-meta">
                                    <i class="fas fa-calendar me-1"></i>
                                    {{ post.publishedAt|date('d/m/Y') }}
                                    
                                    {% if post.category %}
                                        <span class="ms-3">
                                            <i class="fas fa-folder me-1"></i>
                                            <a href="{{ path('frontend_category', {slug: post.category.slug}) }}" class="text-decoration-none">
                                                {{ post.category.name }}
                                            </a>
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="card-footer bg-transparent">
                                <a href="{{ path('frontend_post', {slug: post.slug}) }}" class="btn btn-primary btn-sm">
                                    Lire la suite <i class="fas fa-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </section>
    {% endif %}
    
    <!-- Articles récents -->
    <section class="recent-posts">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="h3 mb-0">
                <i class="fas fa-newspaper me-2"></i>
                Articles Récents
            </h2>
            <a href="{{ path('frontend_posts') }}" class="btn btn-outline-primary">
                Voir tous les articles <i class="fas fa-arrow-right ms-1"></i>
            </a>
        </div>
        
        {% if posts is defined and posts|length > 0 %}
            <div class="row">
                {% for post in posts|slice(0, 6) %}
                    <div class="col-md-6 mb-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">
                                    <a href="{{ path('frontend_post', {slug: post.slug}) }}" class="post-title">
                                        {{ post.title|apply_filter('post_title') }}
                                    </a>
                                </h5>
                                
                                <p class="card-text">{{ post.excerpt|slice(0, 120) }}...</p>
                                
                                <div class="post-meta">
                                    <i class="fas fa-user me-1"></i>
                                    {{ post.author.username }}
                                    
                                    <span class="ms-3">
                                        <i class="fas fa-calendar me-1"></i>
                                        {{ post.publishedAt|date('d/m/Y') }}
                                    </span>
                                    
                                    {% if post.tags is defined and post.tags|length > 0 %}
                                        <div class="mt-2">
                                            {% for tag in post.tags|slice(0, 3) %}
                                                <span class="badge bg-secondary me-1">{{ tag.name }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                            
                            <div class="card-footer bg-transparent">
                                <div class="d-flex justify-content-between align-items-center">
                                    <a href="{{ path('frontend_post', {slug: post.slug}) }}" class="btn btn-primary btn-sm">
                                        Lire l'article
                                    </a>
                                    
                                    {% if post.commentsCount is defined %}
                                        <small class="text-muted">
                                            <i class="fas fa-comments me-1"></i>
                                            {{ post.commentsCount }} commentaire{{ post.commentsCount > 1 ? 's' : '' }}
                                        </small>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-5">
                <i class="fas fa-newspaper fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">Aucun article publié</h4>
                <p class="text-muted">Les premiers articles apparaîtront ici une fois publiés.</p>
            </div>
        {% endif %}
    </section>
    
    <!-- Newsletter (exemple de section personnalisable) -->
    <section class="newsletter-signup bg-light rounded p-4 mt-5">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h3>
                    <i class="fas fa-envelope me-2"></i>
                    Restez informé
                </h3>
                <p class="mb-md-0">Abonnez-vous à notre newsletter pour recevoir les derniers articles directement dans votre boîte mail.</p>
            </div>
            <div class="col-md-4 text-md-end">
                <a href="{{ path('frontend_rss') }}" class="btn btn-primary">
                    <i class="fas fa-rss me-2"></i>
                    S'abonner au flux RSS
                </a>
            </div>
        </div>
    </section>
{% endblock %}
