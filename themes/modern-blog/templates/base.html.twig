<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} - {{ site_name|default('SymfPress') }}</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    
    <!-- Custom Theme Styles -->
    <style>
        :root {
            --primary-color: #2c3e50;
            --secondary-color: #3498db;
            --accent-color: #e74c3c;
            --text-color: #2c3e50;
            --bg-color: #ffffff;
            --card-bg: #f8f9fa;
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            color: var(--text-color);
            background-color: var(--bg-color);
            line-height: 1.6;
        }
        
        .navbar-brand {
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-color) !important;
        }
        
        .hero-section {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
            color: white;
            padding: 80px 0;
            margin-bottom: 50px;
        }
        
        .hero-section h1 {
            font-size: 3.5rem;
            font-weight: 700;
            margin-bottom: 20px;
        }
        
        .hero-section p {
            font-size: 1.2rem;
            opacity: 0.9;
        }
        
        .card {
            border: none;
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 30px;
        }
        
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 25px rgba(0,0,0,0.15);
        }
        
        .post-title {
            color: var(--primary-color);
            text-decoration: none;
            font-weight: 600;
        }
        
        .post-title:hover {
            color: var(--secondary-color);
        }
        
        .post-meta {
            color: #6c757d;
            font-size: 0.9rem;
        }
        
        .sidebar-widget {
            background: var(--card-bg);
            border-radius: 10px;
            padding: 25px;
            margin-bottom: 30px;
            border-left: 4px solid var(--secondary-color);
        }
        
        .sidebar-widget h3 {
            color: var(--primary-color);
            font-size: 1.2rem;
            margin-bottom: 15px;
            font-weight: 600;
        }
        
        .footer {
            background: var(--primary-color);
            color: white;
            padding: 50px 0 30px;
            margin-top: 80px;
        }
        
        .btn-primary {
            background-color: var(--secondary-color);
            border-color: var(--secondary-color);
            border-radius: 25px;
            padding: 10px 25px;
            font-weight: 500;
        }
        
        .btn-primary:hover {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .hero-section h1 {
                font-size: 2.5rem;
            }
            
            .hero-section {
                padding: 50px 0;
            }
        }
        
        /* Dark mode support */
        @media (prefers-color-scheme: dark) {
            :root {
                --primary-color: #ecf0f1;
                --text-color: #ecf0f1;
                --bg-color: #2c3e50;
                --card-bg: #34495e;
            }
        }
    </style>
    
    {% block head_content %}{% endblock %}
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ path('frontend_home') }}">
                <i class="fas fa-blog me-2"></i>
                {{ site_name|default('SymfPress') }}
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                {# Menu principal dynamique #}
                {{ render_menu('primary', {
                    menu_class: 'navbar-nav me-auto',
                    item_class: 'nav-item',
                    link_class: 'nav-link',
                    dropdown_class: 'dropdown',
                    dropdown_menu_class: 'dropdown-menu',
                    dropdown_item_class: 'dropdown-item',
                    active_class: 'active'
                }) }}
                
                {# Fallback si aucun menu n'est défini #}
                {% if not has_menus('primary') %}
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('frontend_home') }}">
                                <i class="fas fa-home me-1"></i> Accueil
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('frontend_posts') }}">
                                <i class="fas fa-newspaper me-1"></i> Articles
                            </a>
                        </li>
                        <!-- Categories dynamiques -->
                        {% if categories is defined %}
                            {% for category in categories %}
                                <li class="nav-item">
                                    <a class="nav-link" href="{{ path('frontend_category', {slug: category.slug}) }}">
                                        {{ category.name }}
                                    </a>
                                </li>
                            {% endfor %}
                        {% endif %}
                    </ul>
                {% endif %}
                
                <!-- Search -->
                <form class="d-flex me-3" action="{{ path('frontend_search') }}" method="GET">
                    <input class="form-control me-2" type="search" placeholder="Rechercher..." name="q">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                </form>
                
                <!-- Language Selector -->
                {{ include('partials/language-selector-dropdown.html.twig') }}
            </div>
        </div>
    </nav>
    
    <!-- Hero Section (only on homepage) -->
    {% if app.request.get('_route') == 'frontend_home' %}
        <section class="hero-section">
            <div class="container text-center">
                <h1>{% block hero_title %}Bienvenue sur Modern Blog{% endblock %}</h1>
                <p class="lead">{% block hero_subtitle %}Un thème moderne et élégant pour votre blog SymfPress{% endblock %}</p>
            </div>
        </section>
    {% endif %}
    
    <!-- Main Content -->
    <div class="container">
        <div class="row">
            <!-- Content -->
            <div class="col-lg-8">
                {% block content %}{% endblock %}
            </div>
            
            <!-- Sidebar -->
            <div class="col-lg-4">
                {% block sidebar %}
                    <!-- Widget de recherche -->
                    <div class="sidebar-widget">
                        <h3><i class="fas fa-search me-2"></i>Recherche</h3>
                        <form action="{{ path('frontend_search') }}" method="GET">
                            <div class="input-group">
                                <input type="text" class="form-control" placeholder="Rechercher..." name="q">
                                <button class="btn btn-primary" type="submit">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                    
                    <!-- Widget articles récents -->
                    <div class="sidebar-widget">
                        <h3><i class="fas fa-clock me-2"></i>Articles Récents</h3>
                        {% if recent_posts is defined %}
                            <ul class="list-unstyled">
                                {% for post in recent_posts|slice(0, 5) %}
                                    <li class="mb-3">
                                        <a href="{{ path('frontend_post', {slug: post.slug}) }}" class="text-decoration-none">
                                            <strong>{{ post.title }}</strong>
                                        </a>
                                        <br>
                                        <small class="text-muted">
                                            <i class="fas fa-calendar me-1"></i>
                                            {{ post.publishedAt|date('d/m/Y') }}
                                        </small>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                    
                    <!-- Widget catégories -->
                    <div class="sidebar-widget">
                        <h3><i class="fas fa-folder me-2"></i>Catégories</h3>
                        {% if categories is defined %}
                            <ul class="list-unstyled">
                                {% for category in categories %}
                                    <li class="mb-2">
                                        <a href="{{ path('frontend_category', {slug: category.slug}) }}" class="text-decoration-none">
                                            <i class="fas fa-tag me-2"></i>{{ category.name }}
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                    
                    <!-- Contenu de sidebar personnalisé (hooks pour les plugins) -->
                    {% set sidebar_content = '' %}
                    {% set sidebar_content = sidebar_content|apply_filter('sidebar_content') %}
                    {{ sidebar_content|raw }}
                {% endblock %}
            </div>
        </div>
    </div>
    
    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5>{{ site_name|default('SymfPress') }}</h5>
                    <p>Propulsé par SymfPress - Un CMS moderne et extensible</p>
                    
                    {# Menu de pied de page #}
                    {% if has_menus('footer') %}
                        <div class="footer-menu mt-3">
                            {{ render_menu('footer', {
                                menu_class: 'list-inline',
                                item_class: 'list-inline-item',
                                link_class: 'text-light',
                                active_class: 'fw-bold'
                            }) }}
                        </div>
                    {% endif %}
                </div>
                <div class="col-md-6 text-md-end">
                    <p>&copy; {{ 'now'|date('Y') }} {{ site_name|default('SymfPress') }}. Tous droits réservés.</p>
                    
                    {# Menu réseaux sociaux #}
                    {% if has_menus('social') %}
                        <div class="social-menu mb-3">
                            {{ render_menu('social', {
                                menu_class: 'd-flex justify-content-md-end justify-content-center',
                                item_class: 'me-3',
                                link_class: 'text-light fs-4',
                                template: 'partials/menu-simple.html.twig'
                            }) }}
                        </div>
                    {% endif %}
                    
                    <p>
                        <small>
                            Thème: Modern Blog v1.0.0 |
                            <a href="{{ path('frontend_sitemap') }}" class="text-light">Plan du site</a> |
                            <a href="{{ path('frontend_rss') }}" class="text-light">RSS</a>
                        </small>
                    </p>
                    
                    <!-- Language selector in footer -->
                    {% if is_multilingual() %}
                        <div class="language-footer mt-2">
                            <small class="text-light opacity-75">
                                <i class="fas fa-globe me-1"></i>Langues:
                                {% for language in get_available_languages() %}
                                    {% if language.id != get_current_language().id %}
                                        <a href="{{ language_switch_url(language.code) }}" class="text-light text-decoration-none ms-2" title="{{ language.name }}">{{ language.code|upper }}</a>
                                    {% else %}
                                        <span class="text-light fw-bold ms-2">{{ language.code|upper }}</span>
                                    {% endif %}
                                {% endfor %}
                            </small>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    {% block scripts %}{% endblock %}
</body>
</html>
