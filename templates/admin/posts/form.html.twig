{% extends 'admin/base.html.twig' %}

{% block page_title %}{{ isEdit ? 'Modifier l\'article' : 'Nouvel article' }}{% endblock %}

{% block breadcrumb %}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Tableau de bord</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_posts_index') }}">Articles</a></li>
        <li class="breadcrumb-item active">{{ isEdit ? 'Modifier' : 'Nouvel article' }}</li>
    </ol>
</nav>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .language-tabs .nav-link {
            border: 1px solid #dee2e6;
            border-bottom: none;
        }
        .language-tabs .nav-link.active {
            border-color: #0d6efd #0d6efd #fff #0d6efd;
            background-color: #fff;
        }
        .translation-content {
            border: 1px solid #dee2e6;
            border-top: none;
            padding: 1rem;
            border-radius: 0 0 0.375rem 0.375rem;
        }
        .required-field {
            color: #dc3545;
        }
    </style>
{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-md-8">
        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
        
        <!-- Informations générales -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">{{ isEdit ? 'Modifier l\'article' : 'Nouvel article' }}</h5>
                <div class="dropdown">
                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                        <i class="fas fa-language me-1"></i> {{ currentLanguage.name }}
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        {% for language in availableLanguages %}
                            <li>
                                <a class="dropdown-item {{ language == currentLanguage ? 'active' : '' }}" 
                                   href="{{ isEdit ? path('admin_posts_edit', {'id': post.id, 'language': language.code}) : path('admin_posts_new', {'language': language.code}) }}">
                                    {{ language.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        {{ form_row(form['translation_' ~ currentLanguage.code ~ '_title']) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_row(form.slug) }}
                    </div>
                </div>
                
                {{ form_row(form['translation_' ~ currentLanguage.code ~ '_excerpt']) }}
            </div>
        </div>

        <!-- Contenu de l'article avec onglets multilingues -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-edit me-1"></i> Contenu de l'article</h6>
            </div>
            <div class="card-body">
                {% if availableLanguages|length > 1 %}
                    <!-- Onglets des langues -->
                    <ul class="nav nav-tabs language-tabs" id="languageTabs" role="tablist">
                        {% for language in availableLanguages %}
                            <li class="nav-item" role="presentation">
                                <button class="nav-link {{ language == currentLanguage ? 'active' : '' }}" 
                                        id="lang-{{ language.code }}-tab" 
                                        data-bs-toggle="tab" 
                                        data-bs-target="#lang-{{ language.code }}" 
                                        type="button" role="tab">
                                    {{ language.name }}
                                    {% if language == currentLanguage %}
                                        <span class="required-field">*</span>
                                    {% endif %}
                                </button>
                            </li>
                        {% endfor %}
                    </ul>
                    
                    <!-- Contenu des onglets -->
                    <div class="tab-content translation-content" id="languageTabContent">
                        {% for language in availableLanguages %}
                            <div class="tab-pane fade {{ language == currentLanguage ? 'show active' : '' }}" 
                                 id="lang-{{ language.code }}" 
                                 role="tabpanel">
                                
                                {{ form_row(form['translation_' ~ language.code ~ '_content']) }}
                                
                                <div class="mt-3">
                                    <button type="button" class="btn btn-outline-secondary btn-sm btn-add-media" data-target="translation_{{ language.code }}_content">
                                        <i class="fas fa-plus me-1"></i> Ajouter un média
                                    </button>
                                </div>
                                
                                <!-- Métadonnées SEO -->
                                <div class="mt-4">
                                    <h6 class="border-bottom pb-2 mb-3">Métadonnées SEO</h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            {{ form_row(form['translation_' ~ language.code ~ '_metaTitle']) }}
                                        </div>
                                        <div class="col-md-6">
                                            {{ form_row(form['translation_' ~ language.code ~ '_metaKeywords']) }}
                                        </div>
                                    </div>
                                    {{ form_row(form['translation_' ~ language.code ~ '_metaDescription']) }}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <!-- Mode monolingue -->
                    {{ form_row(form['translation_' ~ currentLanguage.code ~ '_content']) }}
                    
                    <div class="mt-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm btn-add-media" data-target="translation_{{ currentLanguage.code }}_content">
                            <i class="fas fa-plus me-1"></i> Ajouter un média
                        </button>
                    </div>
                    
                    <!-- Métadonnées SEO -->
                    <div class="mt-4">
                        <h6 class="border-bottom pb-2 mb-3">Métadonnées SEO</h6>
                        <div class="row">
                            <div class="col-md-6">
                                {{ form_row(form['translation_' ~ currentLanguage.code ~ '_metaTitle']) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_row(form['translation_' ~ currentLanguage.code ~ '_metaKeywords']) }}
                            </div>
                        </div>
                        {{ form_row(form['translation_' ~ currentLanguage.code ~ '_metaDescription']) }}
                    </div>
                {% endif %}
            </div>
        </div>
        
        {# Sauvegarde des champs du sidebar avant form_end() pour éviter l'erreur "already rendered" #}
        {% set statusField = form_row(form.status) %}
        {% set publishedAtField = form_row(form.publishedAt) %}
        {% set commentStatusField = form_row(form.commentStatus) %}
        {% set isFeaturedField = form_row(form.isFeatured) %}
        {% set menuOrderField = form_row(form.menuOrder) %}
        
        {{ form_end(form) }}
    </div>
    
    <!-- Sidebar -->
    <div class="col-md-4">
        <!-- Statut et publication -->
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-cogs me-1"></i> Publication</h6>
            </div>
            <div class="card-body">
                {{ statusField|raw }}
                {{ publishedAtField|raw }}
                
                <div class="row">
                    <div class="col-6">
                        {{ commentStatusField|raw }}
                    </div>
                    <div class="col-6">
                        {{ isFeaturedField|raw }}
                    </div>
                </div>
                
                {{ menuOrderField|raw }}
                
                <div class="d-grid gap-2 mt-3">
                    {{ form_widget(form.save) }}
                </div>
            </div>
        </div>
        
        <!-- Image mise en avant -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-image me-1"></i> Image mise en avant</h6>
            </div>
            <div class="card-body">
                <div class="featured-image-selector">
                    {{ form_row(form.featuredImage) }}
                    <div class="mt-2">
                        <button type="button" class="btn btn-outline-primary btn-sm" id="select-featured-image">
                            <i class="fas fa-images me-1"></i>Sélectionner une image
                        </button>
                        <button type="button" class="btn btn-outline-danger btn-sm" id="remove-featured-image" style="display: none;">
                            <i class="fas fa-trash me-1"></i>Supprimer
                        </button>
                    </div>
                    <div id="featured-image-preview" class="mt-2" style="display: none;">
                        <!-- Aperçu de l'image sélectionnée -->
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Catégories -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-folder me-1"></i> Catégories</h6>
            </div>
            <div class="card-body">
                {{ form_row(form.categories) }}
            </div>
        </div>
        
        <!-- Tags -->
        <div class="card mt-4">
            <div class="card-header">
                <h6 class="mb-0"><i class="fas fa-tags me-1"></i> Tags</h6>
            </div>
            <div class="card-body">
                {{ form_row(form.tags) }}
            </div>
        </div>
    </div>
</div>

<!-- Modal de sélection de médias -->
<div class="modal fade" id="mediaModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sélectionner un média</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- Le contenu sera chargé dynamiquement -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Articles: Initialisation du sélecteur de médias');
            
            // Instance unique du modal Bootstrap (réutilisable)
            const modalElement = document.getElementById('mediaModal');
            const modal = new bootstrap.Modal(modalElement);
            const modalBody = document.querySelector('#mediaModal .modal-body');
            const selectFeaturedImageBtn = document.getElementById('select-featured-image');
            const removeFeaturedImageBtn = document.getElementById('remove-featured-image');
            const featuredImageSelect = document.querySelector('#{{ form.featuredImage.vars.id }}');
            const featuredImagePreview = document.getElementById('featured-image-preview');
            
            // Variable globale pour la communication avec le fragment
            window.onMediaSelected = function(mediaId, mediaUrl, mediaTitle) {
                console.log('Articles: Média sélectionné:', mediaId, mediaUrl);
                
                // Mettre à jour le select
                featuredImageSelect.value = mediaId;
                
                // Déclencher l'événement change pour mettre à jour l'aperçu
                featuredImageSelect.dispatchEvent(new Event('change'));
                
                // Fermer le modal
                modal.hide();
                
                console.log('Articles: Sélection terminée, modal fermé');
            };
            
            // Gestion des onglets de langues
            const languageTabs = document.querySelectorAll('#languageTabs button[data-bs-toggle="tab"]');
            languageTabs.forEach(tab => {
                tab.addEventListener('shown.bs.tab', function (event) {
                    console.log('Articles: Onglet activé:', event.target.getAttribute('data-bs-target'));
                });
            });
            
            // Gestion des boutons d'ajout de média
            const addMediaButtons = document.querySelectorAll('.btn-add-media');
            addMediaButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const targetField = this.getAttribute('data-target');
                    console.log('Articles: Ajouter média pour le champ:', targetField);
                    // TODO: Implémenter l'insertion de média dans le contenu
                });
            });
            
            // Fonction pour mettre à jour l'aperçu
            function updateFeaturedImagePreview() {
                const selectedOption = featuredImageSelect.selectedOptions[0];
                if (selectedOption && selectedOption.value) {
                    console.log('Articles: Mise à jour aperçu pour média ID:', selectedOption.value);
                    
                    // Récupérer les infos du média sélectionné
                    fetch(`{{ path('admin_media_info', {'id': '__ID__'}) }}`.replace('__ID__', selectedOption.value))
                        .then(response => response.json())
                        .then(media => {
                            featuredImagePreview.innerHTML = `
                                <div class="border rounded p-2 d-flex align-items-center">
                                    <img src="${media.thumbnailUrl || media.url}" 
                                         alt="${media.alt || media.originalName}" 
                                         class="me-2" 
                                         style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                                    <div>
                                        <div class="fw-bold">${media.originalName}</div>
                                        <small class="text-muted">${media.fileSize}</small>
                                    </div>
                                </div>
                            `;
                            featuredImagePreview.style.display = 'block';
                            removeFeaturedImageBtn.style.display = 'inline-block';
                            console.log('Articles: Aperçu mis à jour avec succès');
                        })
                        .catch(error => {
                            console.error('Articles: Erreur lors de la récupération des infos du média:', error);
                            featuredImagePreview.innerHTML = '<div class="alert alert-danger">Erreur de chargement</div>';
                        });
                } else {
                    featuredImagePreview.style.display = 'none';
                    removeFeaturedImageBtn.style.display = 'none';
                    console.log('Articles: Aperçu masqué (aucun média sélectionné)');
                }
            }
            
            // Initialiser l'aperçu au chargement de la page
            updateFeaturedImagePreview();
            
            // Écouter les changements sur le select
            featuredImageSelect.addEventListener('change', updateFeaturedImagePreview);
            
            // Bouton pour ouvrir le sélecteur de média
            if (selectFeaturedImageBtn) {
                selectFeaturedImageBtn.addEventListener('click', function() {
                    console.log('Articles: Ouverture du sélecteur de médias');
                    
                    // Afficher le spinner de chargement
                    modalBody.innerHTML = '<div class="text-center p-4"><div class="spinner-border" role="status"><span class="visually-hidden">Chargement...</span></div></div>';
                    
                    // Charger le fragment de sélection de média
                    fetch('{{ path('admin_media_selector_fragment', {'type': 'images'}) }}')
                        .then(response => response.text())
                        .then(html => {
                            console.log('Articles: Contenu chargé, longueur:', html.length);
                            
                            // Injecter le contenu dans le modal
                            modalBody.innerHTML = html;
                            
                            // ✅ SOLUTION : Attacher les event listeners APRÈS injection avec setTimeout
                            setTimeout(function() {
                                const mediaItems = modalBody.querySelectorAll('.media-selector-item');
                                console.log('Articles: Event listeners à attacher:', mediaItems.length);
                                
                                mediaItems.forEach((item, index) => {
                                    item.addEventListener('click', function() {
                                        const mediaId = this.dataset.mediaId;
                                        const mediaUrl = this.dataset.mediaUrl || this.dataset.mediaThumbnailUrl;
                                        const mediaTitle = this.dataset.mediaName || this.dataset.mediaAlt;
                                        
                                        console.log('Articles: Clic sur média:', mediaId, 'URL:', mediaUrl);
                                        
                                        // Appeler la fonction globale de sélection
                                        if (typeof window.onMediaSelected === 'function') {
                                            window.onMediaSelected(mediaId, mediaUrl, mediaTitle);
                                        } else {
                                            console.error('Articles: window.onMediaSelected non définie');
                                        }
                                    });
                                    
                                    console.log('Articles: Event listener attaché à l\'item', index);
                                });
                            }, 100); // Délai pour s'assurer que le DOM est prêt après injection
                        })
                        .catch(error => {
                            console.error('Articles: Erreur chargement médias:', error);
                            modalBody.innerHTML = '<div class="alert alert-danger">Erreur lors du chargement du sélecteur de médias</div>';
                        });
                    
                    // Ouvrir le modal (instance unique réutilisée)
                    modal.show();
                });
            }
            
            // Bouton pour supprimer l'image mise en avant
            if (removeFeaturedImageBtn) {
                removeFeaturedImageBtn.addEventListener('click', function() {
                    console.log('Articles: Suppression de l\'image mise en avant');
                    featuredImageSelect.value = '';
                    updateFeaturedImagePreview();
                });
            }
            
            // Validation du formulaire
            const form = document.querySelector('.needs-validation');
            if (form) {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                        console.log('Articles: Formulaire invalide, soumission bloquée');
                    } else {
                        console.log('Articles: Formulaire valide, soumission autorisée');
                    }
                    form.classList.add('was-validated');
                }, false);
            }
            
            console.log('Articles: Initialisation terminée avec succès');
        });
    </script>
{% endblock %}
