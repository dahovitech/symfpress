{# templates/admin/widgets/create.html.twig #}
{% extends 'admin/base.html.twig' %}

{% block title %}Créer un Widget{% endblock %}

{% block main_content %}
<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title mb-0">
                    <i class="fas fa-plus me-2"></i>
                    Créer un Nouveau Widget
                </h4>
            </div>
            
            <div class="card-body">
                <form method="post">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="name" class="form-label">Nom du Widget *</label>
                                <input type="text" class="form-control" id="name" name="name" 
                                       placeholder="Ex: Menu principal" required>
                                <div class="form-text">Nom d'affichage pour identifier le widget</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="type" class="form-label">Type de Widget *</label>
                                <select class="form-select" id="type" name="type" required>
                                    <option value="">Sélectionnez un type</option>
                                    {% for type_key, type_label in widget_types %}
                                        <option value="{{ type_key }}">{{ type_label }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="zone_id" class="form-label">Zone d'affichage *</label>
                                <select class="form-select" id="zone_id" name="zone_id" required>
                                    <option value="">Sélectionnez une zone</option>
                                    {% for zone in zones %}
                                        <option value="{{ zone.id }}">{{ zone.title }} ({{ zone.name }})</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="theme" class="form-label">Thème spécifique</label>
                                <input type="text" class="form-control" id="theme" name="theme" 
                                       placeholder="Laissez vide pour tous les thèmes">
                                <div class="form-text">Optionnel: le widget ne s'affichera que pour ce thème</div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="content" class="form-label">Contenu</label>
                        <textarea class="form-control" id="content" name="content" rows="6" 
                                  placeholder="Contenu du widget (HTML autorisé pour certains types)"></textarea>
                        <div class="form-text">Le contenu dépend du type de widget sélectionné</div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="settings" class="form-label">Paramètres (JSON)</label>
                        <textarea class="form-control" id="settings" name="settings" rows="4" 
                                  placeholder='{"key": "value"}'>{}</textarea>
                        <div class="form-text">Configuration avancée au format JSON</div>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('admin_widgets_index') }}" class="btn btn-secondary">
                            <i class="fas fa-arrow-left"></i> Retour
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Créer le Widget
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
// Aide contextuelle selon le type de widget
document.getElementById('type').addEventListener('change', function() {
    const type = this.value;
    const contentField = document.getElementById('content');
    const settingsField = document.getElementById('settings');
    
    switch(type) {
        case 'text':
            contentField.placeholder = 'Texte ou HTML à afficher';
            settingsField.value = '{}';
            break;
        case 'recent_posts':
            contentField.placeholder = 'Laissez vide pour l\'affichage automatique';
            settingsField.value = '{"limit": 5, "show_date": true, "show_excerpt": false}';
            break;
        case 'search':
            contentField.placeholder = 'Laissez vide pour l\'affichage automatique';
            settingsField.value = '{"placeholder": "Rechercher..."}';
            break;
        case 'menu':
            contentField.placeholder = 'Laissez vide pour utiliser les paramètres';
            settingsField.value = '{"menu_items": [{"label": "Accueil", "url": "/"}]}';
            break;
        case 'custom_html':
            contentField.placeholder = 'Code HTML personnalisé';
            settingsField.value = '{}';
            break;
        default:
            contentField.placeholder = 'Contenu du widget';
            settingsField.value = '{}';
    }
});
</script>
{% endblock %}
