{#
    Sélecteur de langue avec boutons
    Usage: {{ include('partials/language-selector-buttons.html.twig') }}
#}
{% if is_multilingual() %}
    {% set current = get_current_language() %}
    <div class="language-selector language-buttons">
        <div class="btn-group" role="group" aria-label="Choix de langue">
            {% for language in get_available_languages() %}
                <a href="{{ language_switch_url(language.code) }}" 
                   class="btn btn-sm {% if language.id == current.id %}btn-primary active{% else %}btn-outline-primary{% endif %}"
                   {% if language.id == current.id %}aria-current="true"{% endif %}>
                    {{ language.name }}
                </a>
            {% endfor %}
        </div>
    </div>
{% endif %}
