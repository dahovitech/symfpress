{# Template frontend principal - utilise le template par défaut #}
{% extends 'frontend/base_default.html.twig' %}

{# Surcharge des blocs avec logique de thème #}
{% block title %}SymfPress - CMS Multilingue{% endblock %}

{% block meta_description %}SymfPress - Système de gestion de contenu multilingue{% endblock %}

{% block meta_keywords %}cms, symfony, multilingue{% endblock %}

{% block stylesheets %}
    {# CSS par défaut #}
    {{ parent() }}
    
    {# CSS du thème si actif #}
    {% if theme_exists('style.css') %}
        <link href="{{ theme_template('style.css') }}" rel="stylesheet">
    {% endif %}
{% endblock %}

{% block content %}{% endblock %}
